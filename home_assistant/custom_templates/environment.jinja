{#
Get the named direction from the bearing in degrees.

:param bearing: The bearing in degrees.
:param flip: Flip bearing in degrees if the direction must be named according to destination and not origin.

:returns: A named direction, e.g. N for north.
#}
{% macro get_direction_8(bearing, flip=false) -%}
  {% if flip %}
    {% set bearing = (bearing + 180) % 360 %}
  {% endif %}
  {% set directions = ['N','NE','E','SE','S','SW','W','NW'] %}
  {{ directions[((bearing + 22.5) // 45) | int % 8] }}
{%- endmacro %}

{#
Get the directional arrow icon from the bearing in degrees.

:param bearing: The bearing in degrees.

:returns: An MDI icon according to the from direction (N will be an up arrow).
#}
{% macro get_icon_direction_8(bearing) -%}
  {% set icons = [
                   'mdi:arrow-up',
                   'mdi:arrow-top-right',
                   'mdi:arrow-right',
                   'mdi:arrow-bottom-right',
                   'mdi:arrow-down',
                   'mdi:arrow-bottom-left',
                   'mdi:arrow-left',
                   'mdi:arrow-top-left'
                 ] %}
  {{ icons[((bearing + 180 + 22.5) // 45) | int % 8] }}
{%- endmacro %}

{#
Get the next future tide extreme of the given phase from tide extremes data.

:param data: List of extremes dicts ({height, time, type}) as returned by the Stormglass tide endpoint.
:param phase: 'low' or 'high'.

:returns: ISO timestamp of the next extreme, or empty string if none remain.
#}
{% macro next_tide_extreme(data, phase) %}
  {% set times = data
      | default([], true)
      | selectattr('type', 'eq', phase)
      | map(attribute='time')
      | map('as_datetime')
      | select('>', now())
      | sort
      | list %}
  {{ times[0].isoformat() if times else '' }}
{% endmacro %}

{#
Get the current hour's value for a parameter from marine hours data.

:param hours: List of hourly dicts as returned by the Stormglass weather endpoint.
:param param: Stormglass parameter name, e.g. 'swellHeight'.

:returns: The sg value for the latest non-future hour, or empty string if none.
#}
{% macro marine_hour_value(hours, param) %}
  {% set entries = hours
      | default([], true)
      | selectattr('time', 'le', utcnow().isoformat())
      | sort(attribute='time')
      | list -%}
  {{ entries[-1][param].sg if entries else '' }}
{% endmacro %}

{#
Compute a held/decaying rate-of-change (e.g. mm/h) from a monotonically
increasing source value, for use in a trigger-based template sensor that
fires on both a state change of the source entity and a periodic
time_pattern (to detect staleness when the source goes quiet).

Pure calculation only - the caller is responsible for deciding whether this
render was triggered by a fresh sample of the source (e.g.
`trigger.platform == 'state' and trigger.entity_id == entity`), since only
the caller's trigger list makes that unambiguous.

:param current_value: latest reading of the accumulating source value.
:param last_value: reading of the source value as of last_time_iso.
:param last_time_iso: ISO timestamp of last_value, or none if never set.
:param is_fresh_sample: true if this render was triggered by a new sample of the source value.
:param stale_after_minutes: minutes of no new sample before the rate decays to 0.
:param current_state: this sensor's current state, used to hold the rate steady between updates.

:returns: the computed (or held/decayed) rate.
#}
{%- macro compute_rate(current_value, last_value, last_time_iso, is_fresh_sample, stale_after_minutes, current_state) -%}
  {%- if last_time_iso is none -%}
    0
  {%- elif is_fresh_sample -%}
    {%- set elapsed_hours = (now() - as_datetime(last_time_iso)).total_seconds() / 3600 -%}
    {{ ((current_value - last_value) / elapsed_hours) | round(1) if elapsed_hours > 0 else current_state | float(0) }}
  {%- else -%}
    {%- set minutes_since = (now() - as_datetime(last_time_iso)).total_seconds() / 60 -%}
    {{ 0 if minutes_since > stale_after_minutes else current_state | float(0) }}
  {%- endif -%}
{%- endmacro -%}

{#
Pick a calibration gain for a raw precipitation delta based on the current
validated event rate, from an ordered list of rate tiers.

:param event_rate_state: raw state string of the event-rate entity (may be unknown/unavailable/none).
:param tiers: list of {'ceiling': <rate>, 'gain': <gain>} dicts, sorted ascending by ceiling.
              the first tier whose ceiling exceeds event_rate is used.
:param default_gain: gain to apply when the rate is unvalidated or exceeds every tier's ceiling.

:returns: the gain to multiply the raw delta by.
#}
{%- macro select_gain(event_rate_state, tiers, default_gain) -%}
  {%- if event_rate_state in ['unknown', 'unavailable', 'none'] -%}
    {{ default_gain }}
  {%- else -%}
    {%- set event_rate = event_rate_state | float(0) -%}
    {%- set match = tiers | selectattr('ceiling', '>', event_rate) | list | first -%}
    {{ match.gain if match else default_gain }}
  {%- endif -%}
{%- endmacro -%}

{#
Cold tiers below the summer simmer index's floor.

The index is a heat index: below 21.1°C (70°F) there is no heat stress left to measure and it
collapses into a single 'cool' tier, so a 5°C morning reads the same as a mild 20°C evening. This
splits that tier and passes the rest of the scale through untouched.

The two threshold sets are not the same scale. Outdoors the temperature passed in is an apparent
temperature, since wind is what makes cold bite; indoors it is dry-bulb, because there is no wind
and humidity barely moves perceived cold. The indoor numbers also sit higher because you are
sedentary and lightly dressed there - an 18°C room is chilly, an 18°C walk is pleasant.

:param temperature: temperature to judge, in °C. Apparent outdoors, dry-bulb indoors.
:param perception: the underlying index state, returned unchanged above the cold tiers.
:param indoor: true to use the indoor thresholds.
:returns: snake_case tier name, or the perception unchanged. Untrimmed, so use | trim if the
          result is compared rather than rendered as an entity state.
#}
{%- macro thermal_tier(temperature, perception, indoor=false) -%}
  {%- set cold      = 18 if indoor else 15 -%}
  {%- set very_cold = 15 if indoor else 10 -%}
  {%- set freezing  = 12 if indoor else  5 -%}
  {%- if temperature is none -%} {{ perception }}
  {%- elif temperature < freezing -%} freezing
  {%- elif temperature < very_cold -%} very_cold
  {%- elif temperature < cold -%} cold
  {%- else -%} {{ perception }}
  {%- endif -%}
{%- endmacro -%}

{#
Beaufort scale tier for a wind speed.

:param speed_kmh: wind speed in km/h.
:returns: snake_case tier name, matching sensor.wind_condition_beaufort's states.
#}
{%- macro beaufort_scale(speed_kmh) -%}
  {%- if speed_kmh < 1.8 -%} calm
  {%- elif speed_kmh < 5.8 -%} light_air
  {%- elif speed_kmh < 12.2 -%} light_breeze
  {%- elif speed_kmh < 19.8 -%} gentle_breeze
  {%- elif speed_kmh < 28.8 -%} moderate_breeze
  {%- elif speed_kmh < 38.9 -%} fresh_breeze
  {%- elif speed_kmh < 50.0 -%} strong_breeze
  {%- elif speed_kmh < 61.9 -%} near_gale
  {%- elif speed_kmh < 74.9 -%} gale
  {%- elif speed_kmh < 88.2 -%} strong_gale
  {%- elif speed_kmh < 102.6 -%} storm
  {%- elif speed_kmh < 117.7 -%} violent_storm
  {%- else -%} extreme_storm
  {%- endif -%}
{%- endmacro -%}

{#
Display label for a wind speed's Beaufort scale tier.

:param speed_kmh: wind speed in km/h.
:returns: title-cased display label, or 'Unknown' if the tier isn't recognised.
#}
{%- macro beaufort_label(speed_kmh) -%}
  {%- set labels = {
    'calm': 'Calm',
    'light_air': 'Light',
    'light_breeze': 'Light',
    'gentle_breeze': 'Gentle',
    'moderate_breeze': 'Moderate',
    'fresh_breeze': 'Fresh',
    'strong_breeze': 'Strong',
    'near_gale': 'Gale',
    'gale': 'Gale',
    'strong_gale': 'Gale',
    'storm': 'Storm',
    'violent_storm': 'Violent',
    'extreme_storm': 'Extreme'
  } -%}
  {{ labels.get(beaufort_scale(speed_kmh), 'Unknown') }}
{%- endmacro -%}

{#
Rain outlook from an hourly forecast.

:param forecast: hourly forecast list from weather.get_forecasts
:returns: dict with 'hours' (count of likely wet hours in the planning window,
          from 3h out to mid-morning tomorrow), 'onset' (datetime string
          of the start of the first likely wet spell from now, or none), 'mm'
          (rain from onset over the next 24h, or as much of it as the forecast
          reaches) and 'mm_hours' (how many hours that is). both none under 12h.

the window runs from 3h out to 10:00 tomorrow: far enough ahead to act on,
and it ends once the morning brief can take over. rain later tomorrow is left
to tomorrow's own run, which will call it today.

an hour has to be both wet and likely to count, as OWM calls an hour rainy
for a trace.

'onset' looks from now rather than from the window start, so the leading edge
cannot clip a spell already under way. it is the first wet hour of the spell
containing the first likely hour, not the first wet hour anywhere: rain firms
up over a few hours, so the hour that clears the threshold sits mid-band, and
a lone shower before it is a different event.
#}
{%- macro rain_outlook(forecast, returns) -%}
  {%- set wet = ['rainy', 'pouring', 'lightning-rainy', 'hail'] -%}
  {%- set likely = 50 -%}
  {%- set now_utc = utcnow() -%}
  {%- set start = now_utc + timedelta(hours=3) -%}
  {%- set end = today_at('10:00') + timedelta(days=1) -%}
  {# one pass, so the count and the onset search share one idea of a wet hour.
     datetimes are parsed rather than compared as strings: the forecast's
     offset is not ours to assume #}
  {%- set ns = namespace(hours=0, onset=none, spell=none, mm=0) -%}
  {%- for f in forecast -%}
    {%- set dt = f.datetime | as_datetime -%}
    {%- set is_wet = f.condition in wet -%}
    {%- set is_likely = is_wet and f.precipitation_probability | float(0) >= likely -%}
    {%- if is_likely and dt >= start and dt < end -%}
      {%- set ns.hours = ns.hours + 1 -%}
    {%- endif -%}
    {%- if dt >= now_utc and dt < end -%}
      {%- if not is_wet -%}
        {%- set ns.spell = none -%}
      {%- else -%}
        {%- if ns.spell is none -%}
          {%- set ns.spell = f.datetime -%}
        {%- endif -%}
        {%- if is_likely and ns.onset is none -%}
          {%- set ns.onset = ns.spell -%}
        {%- endif -%}
      {%- endif -%}
    {%- endif -%}
  {%- endfor -%}

  {# total rain over the 24h from onset, or as far as the forecast reaches,
     with the hours it covers. totals from about 12h up hold steady between
     forecasts where single hours do not, so 12h is the floor #}
  {%- set onset_dt = ns.onset | as_datetime if ns.onset else none -%}
  {%- set tail = ((forecast[-1].datetime | as_datetime - onset_dt).total_seconds() / 3600)
                 | round | int + 1 if onset_dt else 0 -%}
  {%- set mm_hours = [24, tail] | min -%}
  {%- if mm_hours >= 12 -%}
    {%- set stop = onset_dt + timedelta(hours=mm_hours) -%}
    {%- for f in forecast -%}
      {%- set dt = f.datetime | as_datetime -%}
      {%- if dt >= onset_dt and dt < stop -%}
        {%- set ns.mm = ns.mm + (f.precipitation | float(0)) -%}
      {%- endif -%}
    {%- endfor -%}
  {%- endif -%}

  {%- do returns({'hours': ns.hours,
                  'onset': ns.onset,
                  'mm': ns.mm | round(1) if mm_hours >= 12 else none,
                  'mm_hours': mm_hours if mm_hours >= 12 else none}) -%}
{%- endmacro -%}
